<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1;">
        <ui:VisualElement class="mv-header">
            <ui:Button name="back" class="mv-icon-btn" tooltip="Voltar"><MtgAr.UI.LineArt kind="Back" picking-mode="Ignore" style="width: 24px; height: 24px;" /></ui:Button>
            <ui:Label name="title" class="mv-header__title" text="Nova partida" />
        </ui:VisualElement>
        <ui:ScrollView class="mv-content">
            <ui:VisualElement>
                <ui:Label class="mv-section-label" text="MEU DECK" />
                <ui:VisualElement name="my-decks" class="mv-chip-row" />
            </ui:VisualElement>
            <ui:VisualElement>
                <ui:Label class="mv-section-label" text="DECK DO OPONENTE" />
                <ui:VisualElement name="opp-decks" class="mv-chip-row" />
                <ui:Label name="unknown-hint" class="mv-row__sub" text="Sem a lista do oponente o app procura entre todas as cartas: o reconhecimento fica um pouco mais lento." style="display: none;" />
            </ui:VisualElement>
            <ui:VisualElement>
                <ui:Label class="mv-section-label" text="COMO O CELULAR VAI FICAR" />
                <ui:VisualElement name="modes" />
            </ui:VisualElement>
            <ui:VisualElement>
                <ui:Label class="mv-section-label" text="VIDA INICIAL" />
                <ui:VisualElement name="lives" class="mv-chip-row" />
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement class="mv-footer">
            <ui:Label name="no-deck" class="mv-row__sub" text="Importe um deck primeiro (Meus decks › Importar)." style="display: none; margin-bottom: 8px;" />
            <ui:Button name="calibrate" class="mv-btn mv-btn--primary mv-btn--large" text="Calibrar a mesa" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
